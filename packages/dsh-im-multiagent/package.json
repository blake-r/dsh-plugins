{
  "name": "@blake-r/dsh-im-multiagent",
  "version": "0.1.0",
  "description": "One Telegram chat, all active Harness sessions: auto-discovered session mirror with reply-based routing.",
  "type": "module",
  "main": "plugin-src/host/index.mjs",
  "exports": {
    ".": "./plugin-src/host/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin-src",
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs",
    "check": "node --check plugin-src/host/index.mjs && node --check plugin-src/client/index.js && node scripts/build.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "connection",
        "locale"
      ]
    }
  },
  "dependencies": {
    "undici": "^8.10.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}