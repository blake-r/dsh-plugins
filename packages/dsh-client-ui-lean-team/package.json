{
  "name": "@blake-r/dsh-client-ui-lean-team",
  "version": "0.1.0",
  "description": "DSH Web UI plugin: the Lean Team kanban board's entry — an icon in the conversation header's utilities row that opens the board as a 100%-covering modal (a same-origin iframe at /lean-team/).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}